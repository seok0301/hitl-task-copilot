# DB (docker compose 기본값)
DATABASE_URL=postgresql+psycopg://hitl:hitl@localhost:5442/hitl

# LLM 프로바이더: litellm | gemini | mock
LLM_PROVIDER=litellm
LLM_MODEL=gemma-4-26b

# OpenAI 호환 LiteLLM endpoint
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=

# Gemini를 쓸 때만 필요
GEMINI_API_KEY=

# 로컬 CPU 임베딩 (fastembed), mock이면 해시 기반 가짜 임베딩
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

JWT_SECRET=change-me
